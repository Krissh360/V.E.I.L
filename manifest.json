{
  "manifest_version": 3,
  "name": "VEIL — Visual Edge Inference Layer",
  "version": "0.1.0",
  "description": "Privacy-first browser AI agent: perceives pages locally, redacts PII on-device, executes safe actions.",

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "VEIL"
  },

  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/dom-extractor.ts",
        "src/content/action-executor.ts",
        "src/content/overlay.ts"
      ],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "models/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
